import { Pressable, StyleSheet, Text, View } from 'react-native';

import { useState } from 'react';

export default function App() {
  const [cliques, atualizarCliques] = useState(0);
  const [cliques1, atualizarCliques2] = useState(0);

  return (
    <View style={styles.tela}>
      <Text style={styles.titulo}>TRUCO</Text>
      <View style={styles.times}>
        <View style={styles.time}>
          <Text style={styles.texto}>TIME A</Text>

          <Text style={styles.texto}>Pontuação:</Text>

          <Text style={styles.pontuacao}>{cliques}</Text>

          <Pressable
            style={styles.botaoMais}
            onPress={() => {
              const novaPontuacao = cliques + 1;

              if (novaPontuacao <= 12) {
                atualizarCliques(novaPontuacao);

                if (novaPontuacao === 12) {
                  alert('Fim de jogo,o time A ganhou!');
                }
              }
            }}>
            <Text style={styles.textoBotao}>+1</Text>
          </Pressable>

          <Pressable
            style={styles.botaoMenos}
            onPress={() => {
              if (cliques > 0) {
                atualizarCliques(cliques - 1);
              }
            }}>
            <Text style={styles.textoBotao}>-1</Text>
          </Pressable>
        </View>

        <View style={styles.time}>
          <Text style={styles.texto}>TIME B</Text>
          <Text style={styles.texto}>Pontuação:</Text>
          <Text style={styles.pontuacao}>{cliques1}</Text>

          <Pressable
            style={styles.botaoMais}
            onPress={() => {
              const novaPontuacao = cliques1 + 1;

              if (novaPontuacao <= 12) {
                atualizarCliques2(novaPontuacao);

                if (novaPontuacao === 12) {
                  alert('Fim de jogo,o time B ganhou!');
                }
              }
            }}>
            <Text style={styles.textoBotao}>+1</Text>
          </Pressable>

          <Pressable
            style={styles.botaoMenos}
            onPress={() => {
              if (cliques1 > 0) {
                atualizarCliques2(cliques1 - 1);
              }
            }}>
            <Text style={styles.textoBotao}>-1</Text>
          </Pressable>
        </View>
      </View>

      <Pressable
        style={styles.botaoNovaPartida}
        onPress={() => {
          atualizarCliques(0);
          atualizarCliques2(0);
        }}>
        <Text style={styles.textoNovaPartida}>reiniciar</Text>
      </Pressable>
    </View>
  );
}

